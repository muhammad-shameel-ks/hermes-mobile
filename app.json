{
  "expo": {
    "name": "Hermes",
    "slug": "hermes-mobile",
    "version": "0.1.32",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.hermes.mobile",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "dev.hermes.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "versionCode": 132
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-web-browser",
      "./plugins/with-ios-scene-lifecycle.js",
      "./plugins/with-android-text-metrics.js",
      "./plugins/with-android-bold-text.js",
      "expo-font",
      "expo-sqlite",
      "expo-video",
      "expo-audio",
      "expo-sharing",
      "expo-asset",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Hermes uses the microphone for dictation.",
          "speechRecognitionPermission": "Hermes uses speech recognition for dictation."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Hermes attaches photos you choose to your messages.",
          "cameraPermission": "Hermes attaches photos you take to your messages."
        }
      ],
      [
        "expo-media-library",
        {
          "savePhotosPermission": "Hermes saves images you choose to your photo library.",
          "isAccessMediaLocationEnabled": false
        }
      ]
    ]
  }
}
